    "从到期前 %lld 天起每天提醒；过期后每天继续提醒，直到标记完成。" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alerts daily from %lld day before the due date, then daily while overdue until marked done."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alerts daily from %lld days before the due date, then daily while overdue until marked done."
                }
              }
            }
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從到期前 %lld 天起每天提醒；過期後每天繼續提醒，直到標記完成。"
          }
        }
      }
    },
