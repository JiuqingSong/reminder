    "不添加，把原有的改为需要买" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't Add; Mark Existing as Need to Buy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No añadir; marcar el existente como \"Hay que comprar\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加せず、既存のものを「要購入」にする"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가하지 않고 기존 물건을 '구매 필요'로 변경"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不加入，把原有的改為需要買"
          }
        }
      }
    },
    "不设日期即为常年提醒，固定显示在列表顶部，不发通知。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a date it's an ongoing reminder: pinned to the top, no notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin fecha es un recordatorio fijo: queda arriba de la lista y no envía notificaciones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付を設定しないと常時リマインダーになり、リストの一番上に固定され、通知は送られません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜를 정하지 않으면 상시 리마인더가 되어 목록 맨 위에 고정되고 알림은 보내지 않습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不設日期即為常駐提醒，固定顯示在清單頂部，不發通知。"
          }
        }
      }
    },
