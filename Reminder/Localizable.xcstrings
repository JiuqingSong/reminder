    "从到期前 %lld 天起每天提醒；过期后每天继续提醒，直到标记完成。" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alerts daily from %lld day before the due date, then daily while overdue until marked done."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alerts daily from %lld days before the due date, then daily while overdue until marked done."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Avisa cada día desde %lld día antes del vencimiento y, si se pasa, cada día hasta marcarlo como hecho."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Avisa cada día desde %lld días antes del vencimiento y, si se pasa, cada día hasta marcarlo como hecho."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限の%lld日前から毎日通知し、期限を過ぎたら完了にするまで毎日通知します。"
          }
        },
