    "不关联地图，不能开启到店提醒。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not linked to the map, so arrival alerts are unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está vinculado al mapa, así que no hay avisos de llegada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図に紐づかないため、到着通知は使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도와 연결되지 않아 도착 알림을 쓸 수 없습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不連結地圖，無法開啟到店提醒。"
          }
        }
      }
    },
    "不关联地图，不能开启到店提醒。会同时加入常用地点。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not linked to the map, so arrival alerts are unavailable. It's also saved to your places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está vinculado al mapa, así que no hay avisos de llegada. También se guarda en tus lugares."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図に紐づかないため、到着通知は使えません。保存した場所にも追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도와 연결되지 않아 도착 알림을 쓸 수 없습니다. 저장된 장소에도 추가됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不連結地圖，無法開啟到店提醒。會同時加入常用地點。"
          }
        }
      }
    },
