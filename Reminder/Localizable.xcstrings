          "stringUnit" : {
            "state" : "translated",
            "value" : "When you arrive and there are items to buy here, you'll be alerted right away—every time you arrive."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到達這個地點、並且有需要在這裡買的物品時，馬上提醒你。每次到達都會提醒。"
