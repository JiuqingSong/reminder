    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to take photos and attach them to reminders"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於拍照並附加到提醒事項"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to search for shopping places on the map, and to remind you what you can buy when you arrive at a place with alerts on"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於在地圖上搜尋購物地點，並在你到達開啟了提醒的地點時，提醒你可以在那裡買的物品"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to choose photos from your library to attach to reminders"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於從相簿選擇圖片附加到提醒事項"
          }
        }
      }
    }
  },
  "version" : "1.0"
