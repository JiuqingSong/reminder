    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to take photos and attach them to reminders"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para tomar fotos y adjuntarlas a los recordatorios"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を撮ってリマインダーに添付するために使用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 찍어 리마인더에 첨부하는 데 사용합니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於拍照並附加到提醒事項"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to search for shopping places on the map, and to remind you what you can buy when you arrive at a place with alerts on"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para buscar lugares de compra en el mapa y avisarte de lo que puedes comprar al llegar a un lugar con avisos activados"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図で買い物する場所を検索し、到着通知がオンの場所に着いたときにそこで買えるものを通知するために使用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에서 쇼핑 장소를 검색하고, 도착 알림이 켜진 장소에 도착했을 때 그곳에서 살 수 있는 물건을 알려 주는 데 사용합니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於在地圖上搜尋購物地點，並在你到達開啟了提醒的地點時，提醒你可以在那裡買的物品"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to choose photos from your library to attach to reminders"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para elegir fotos de tu fototeca y adjuntarlas a los recordatorios"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真ライブラリから画像を選んでリマインダーに添付するために使用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 보관함에서 사진을 골라 리마인더에 첨부하는 데 사용합니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於從相簿選擇圖片附加到提醒事項"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
